# ==============================================================================
# AgentGate Configuration Template
# Copy this file to .env and fill in real values. NEVER commit .env.
# ==============================================================================

# --- Engine Service ---
DATABASE_URL=postgresql+psycopg://agentgate:agentgate@localhost:5432/agentgate
REDIS_URL=redis://localhost:6379/0
GITHUB_TOKEN=ghp_example_token_replace_with_real_pat
LLM_PROVIDER=gemini            # gemini | openai_compatible | fake
LLM_API_KEY=replace_with_gemini_or_openai_api_key
LLM_MODEL=gemini-1.5-pro
LLM_BASE_URL=                  # only needed for openai_compatible / local models
LLM_MAX_TOKENS_PER_REVIEW=60000
LLM_DAILY_TOKEN_BUDGET=1000000
SANDBOX_IMAGE=agentgate-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1
ENGINE_INTERNAL_TOKEN=agentgate_internal_secret_change_in_prod

# --- Gateway Service (Spring Boot) ---
GATEWAY_DB_URL=jdbc:postgresql://localhost:5432/agentgate
GATEWAY_DB_USER=agentgate
GATEWAY_DB_PASSWORD=agentgate
JWT_SECRET=agentgate-super-secret-jwt-signing-key-32chars!
GITHUB_WEBHOOK_SECRET=agentgate-webhook-secret-change-me-32chars
ENGINE_BASE_URL=http://localhost:8001
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword

# --- Dashboard (Vite / React) ---
VITE_API_BASE_URL=http://localhost:8080
